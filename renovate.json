{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "platformAutomerge": false,
  "minimumReleaseAge": "1 day",
  "vulnerabilityAlerts": {
    "description": "Renovate defaults this to null, so security-fix PRs would skip the wait.",
    "minimumReleaseAge": "1 day"
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/renovate\\.yml$/"],
      "matchStrings": ["--package renovate@(?<currentValue>\\S+)"],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Renovate releases several times a day; bump the validator weekly.",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["renovate"],
      "schedule": ["before 6am on monday"]
    },
    {
      "description": "mise names staticcheck by package path, which has no version tags; look up its module.",
      "matchDepNames": ["go:honnef.co/go/tools/cmd/staticcheck"],
      "overridePackageName": "honnef.co/go/tools"
    }
  ]
}
