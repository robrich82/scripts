{
  "permissions": {
    "allow": [
      "Bash(make vet)",
      "Bash(make vet-linux)",
      "Bash(make test)",
      "Bash(mise exec -- make vet)",
      "Bash(mise exec -- make vet-linux)",
      "Bash(mise exec -- make test)",
      "Bash(go vet ./...)",
      "Bash(golangci-lint run ./...)",
      "Bash(golangci-lint fmt --diff ./...)",
      "Bash(mise exec -- golangci-lint run ./...)",
      "Bash(gofmt -l .)",
      "Bash(git fetch origin -q)",
      "Bash(git fetch -q origin)",
      "Skill(build)",
      "Skill(check)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-go-build.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/gofmt-on-edit.sh\""
          }
        ]
      }
    ]
  }
}
