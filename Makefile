.PHONY: all clean cbz-fix mkv-audit mkv-movie mkv-music mkv-tvshow sw-update test vet vuln

all: cbz-fix mkv-audit mkv-movie mkv-music mkv-tvshow sw-update

cbz-fix:
	cd cbz-fix && go build -o ../dist/cbz-fix.exe .

mkv-audit:
	cd mkv-audit && go build -o ../dist/mkv-audit.exe .

mkv-movie:
	cd mkv-movie && go build -o ../dist/mkv-movie.exe .

mkv-music:
	cd mkv-music && go build -o ../dist/mkv-music.exe .

mkv-tvshow:
	cd mkv-tvshow && go build -o ../dist/mkv-tvshow.exe .

sw-update:
	cd sw-update && go build -o ../dist/sw-update.exe .

test:
	cd cbz-fix && go test ./...
	cd mkv-audit && go test ./...
	cd mkv-movie && go test ./...
	cd mkv-music && go test ./...
	cd mkv-tvshow && go test ./...
	cd sw-update && go test ./...

vet:
	cd cbz-fix && go vet ./... && gofmt -l . | (! grep .) && staticcheck ./... && unparam ./...
	cd mkv-audit && go vet ./... && gofmt -l . | (! grep .) && staticcheck ./... && unparam ./...
	cd mkv-movie && go vet ./... && gofmt -l . | (! grep .) && staticcheck ./... && unparam ./...
	cd mkv-music && go vet ./... && gofmt -l . | (! grep .) && staticcheck ./... && unparam ./...
	cd mkv-tvshow && go vet ./... && gofmt -l . | (! grep .) && staticcheck ./... && unparam ./...
	cd sw-update && go vet ./... && gofmt -l . | (! grep .) && staticcheck ./... && unparam ./...

# Requires govulncheck and network access to the Go vulnerability database:
#   go install golang.org/x/vuln/cmd/govulncheck@latest
vuln:
	cd cbz-fix && govulncheck ./...
	cd mkv-audit && govulncheck ./...
	cd mkv-movie && govulncheck ./...
	cd mkv-music && govulncheck ./...
	cd mkv-tvshow && govulncheck ./...
	cd sw-update && govulncheck ./...

clean:
	rmdir /s /q dist 2>nul || true
